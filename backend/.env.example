NODE_ENV=development
PORT=5001

MONGO_URL=mongodb://localhost:27017/devquora

JWT_SECRET=changeme
JWT_LIFETIME=7d
COOKIE_LIFETIME=7

# CORS allow-list. FRONTEND_URL is your normal dev/staging origin;
# PROD_FRONTEND_URL is the deployed Netlify site (e.g. https://devquora.netlify.app).
# localhost:5173/5174 are always allowed regardless of these — see app.js.
FRONTEND_URL=http://localhost:5173
PROD_FRONTEND_URL=https://yourdomain.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — raises dev.to's public API rate ceiling; sync works fine unset.
DEVTO_API_KEY=
# How often the dev.to content sync re-runs, in ms. Defaults to 1 hour if unset.
SYNC_INTERVAL_MS=3600000
